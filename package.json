{
  "name": "ragdoll-pvp",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "vitest run",
    "sim": "tsx tools/sim.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "netsim": "tsx tools/netsim.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
